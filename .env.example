# Kerno (SoftPOS) server configuration — TEMPLATE ONLY.
#
#   cp .env.example .env      # .env is git-ignored; never commit it
#
# Every variable the server reads is listed here (cmd/server/config_guard.go
# ServerEnvVars; a test keeps this file in sync). Secrets ship as CHANGE_ME
# placeholders: with APP_ENV=production the server refuses to boot while any
# secret is a placeholder, too short, a public dev default, or missing.
# Generate secrets with:   openssl rand -hex 32
# In production prefer a secrets manager / KMS injecting these variables
# instead of a .env file on disk.

# --- Environment -------------------------------------------------------------
# "production" (or "prod") enables the fail-fast security guard. ENV is a
# fallback name for the same setting.
APP_ENV=development
# ENV=

# Local-development conveniences: ephemeral JWT/CoDi secrets, the public dev
# vault key and dev STP HMAC secret, OTP codes in logs, /auth/dev-session.
# NEVER enable outside a laptop; rejected with APP_ENV=production.
DEV_MODE=false
# Seeds the demo merchant (merch_demo_01). Defaults to true when unset;
# must be false in production.
SEED_DEMO_MERCHANT=false

# --- HTTP ---------------------------------------------------------------------
PORT=8080
# Directory with the Web POS static assets (container: /app/web/pos).
STATIC_DIR=/app/web/pos

# --- PostgreSQL (required in production) ---------------------------------------
# Without DATABASE_URL all state is in memory (dev only). Production requires
# TLS (sslmode=require or stricter); sslmode=disable is only acceptable on the
# private docker-compose network.
DATABASE_URL=postgres://softpos:CHANGE_ME@postgres:5432/softpos?sslmode=disable
# database/sql driver name; default pgx.
# SQL_DRIVER=pgx
# Empty = migrations embedded in the binary; a path overrides them.
# MIGRATIONS_DIR=
# Used only by docker-compose.yml for the postgres container; must match the
# password inside DATABASE_URL.
POSTGRES_PASSWORD=CHANGE_ME

# --- Redis (optional distributed idempotency cache) ----------------------------
REDIS_ADDR=redis:6379
# Required (>= 16 bytes) in production when REDIS_ADDR is set. docker-compose
# also uses it for redis-server --requirepass.
REDIS_PASSWORD=CHANGE_ME

# --- Auth (docs/AUTH.md) -------------------------------------------------------
# HS256 signing secret, >= 32 bytes. Required unless DEV_MODE=true.
JWT_SECRET=CHANGE_ME
# Access / refresh token lifetimes (Go durations). Defaults 15m / 720h.
# AUTH_ACCESS_TTL=15m
# AUTH_REFRESH_TTL=720h
# Per-IP budget for /api/v1/auth/* (default 30).
# AUTH_RATE_LIMIT_PER_MINUTE=30
# Play Integrity verification secret (>= 32 bytes when set); empty disables
# /api/v1/auth/attestation/verify (503).
PLAY_INTEGRITY_SECRET=
# PLAY_INTEGRITY_PACKAGE=mx.softpos.app

# --- Webhooks -----------------------------------------------------------------
# HMAC secret for POST /api/v1/webhooks/codi/confirm, >= 32 bytes (required in
# production; empty outside DEV_MODE disables the webhook).
CODI_WEBHOOK_SECRET=CHANGE_ME
# HMAC secret for STP webhooks, >= 32 bytes in production.
STP_HMAC_SECRET=CHANGE_ME
# STP base URL (the real STP client is not wired yet; the server uses a mock).
# STP_BASE_URL=

# --- CSD vault (docs/AUTH.md) --------------------------------------------------
# Active 32-byte master key as 64 hex chars (openssl rand -hex 32). Required
# unless DEV_MODE=true; the public dev key is rejected outside DEV_MODE.
VAULT_MASTER_KEY_HEX=CHANGE_ME
# Key id stored in each envelope (default v1).
# VAULT_MASTER_KEY_ID=v1
# Retired keys kept for decryption: "id:hex,id:hex".
VAULT_PREVIOUS_KEYS=

# --- Money flows (docs/MONEY_FLOWS.md) -----------------------------------------
# Platform tariff for merchants without their own, 0..10000 bps.
# DEFAULT_PLATFORM_FEE_BPS=
# true lets cashiers refund settled payments (default owner-only).
# ALLOW_CASHIER_REFUNDS=false

# --- Card processor (docs/ACQUIRER_INTEGRATION.md) ---------------------------
# Certified acquirer adapter for card payments: "mock" (deterministic, tests
# and DEV_MODE only; rejected in production) or empty = card payments
# disabled (503). DEV_MODE defaults it to mock. Real adapters (Adyen, Mercado
# Pago, Clip...) are added when the processor is contracted.
ACQUIRER_PROVIDER=
# HMAC-SHA256 secret of POST /api/v1/webhooks/acquirer/{provider} (Kerno
# scheme, X-Kerno-Timestamp / X-Kerno-Signature), >= 32 bytes; required in
# production when ACQUIRER_PROVIDER is set. Empty outside DEV_MODE disables
# the webhook (503).
ACQUIRER_WEBHOOK_SECRET=CHANGE_ME
# How often captures the processor has not paid out by their expected
# settlement date (+1 day) are flagged NOT_SETTLED (runs only with
# DATABASE_URL; default 1h).
# ACQUIRER_RECONCILE_INTERVAL=1h

# --- Merchant onboarding / KYB (docs/KYB.md) -----------------------------------
# Identity verification provider (liveness + INE) run at KYB submission:
# "mock" (tests / DEV_MODE only; rejected in production) or empty = no
# automatic check (operators review the documents). DEV_MODE defaults to mock.
KYC_PROVIDER=

# --- Outbox dispatcher (runs only with DATABASE_URL) ---------------------------
# OUTBOX_POLL_INTERVAL=2s
# OUTBOX_BATCH_SIZE=50
# log (default) | noop
# OUTBOX_PUBLISHER=log
# Per-event publish timeout (always kept below the 5m lease).
# OUTBOX_PUBLISH_TIMEOUT=30s

# --- Payout recovery (runs only with DATABASE_URL; docs/MONEY_FLOWS.md) -------
# How often stale RESERVED / PENDING_RECONCILIATION payouts are checked
# against STP order status.
# PAYOUT_RECONCILE_INTERVAL=1m
# Minimum age before recovery touches a payout (>= 1m; default 10m).
# PAYOUT_RECONCILE_AFTER=10m
